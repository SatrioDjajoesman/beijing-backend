#include <WiFi.h>
#include <WebSocketsClient.h>
#include "HX711.h"

// --- Device Identity ---
// IMPORTANT: change this to a unique value on each of the 3 ESP32 boards
// before uploading, e.g. "esp32-1", "esp32-2", "esp32-3"
const char* DEVICE_ID = "esp32-1";

// --- WiFi Credentials ---
const char* WIFI_SSID = "Abuserin wifi6";
const char* WIFI_PASSWORD = "Alderar2019";

// --- WebSocket Server (your laptop) ---
const char* WS_HOST = "192.168.50.193";
const uint16_t WS_PORT = 8080;
const char* WS_PATH = "/";

WebSocketsClient webSocket;

// --- Moisture Sensor Pins ---
const int moisturePin1 = 32;
const int moisturePin2 = 35;
const int moisturePin3 = 34;

// --- Moisture Calibration Thresholds ---
// Adjust these numbers based on your specific soil tests!
const int DRY_THRESHOLD = 3200; // Readings HIGHER than this are "Dry"
const int WET_THRESHOLD = 2200; // Readings LOWER than this are "Wet"

// --- Pressure Sensor Pins (Updated Layout) ---
// Sensor 1
const int PRESS_1_OUT = 21;
const int PRESS_1_SCK = 5;

// Sensor 2
const int PRESS_2_OUT = 19;
const int PRESS_2_SCK = 4;

// Sensor 3
const int PRESS_3_OUT = 22;
const int PRESS_3_SCK = 18;

// Initialize three separate sensor objects
// NOTE: these are MPS20N0040D pressure sensors driven by an HX710B
// (0-40kPa gauge pressure). HX710B is register/protocol-compatible with the
// HX711 (same shift-in timing), so the HX711 library works here, but it is
// fixed at 10 SPS with no gain-64/32 channel-B option like the real HX711.
HX711 sensor1;
HX711 sensor2;
HX711 sensor3;

// --- Pressure Calibration (kPa) ---
// Each HX710B/MPS20N0040D needs its own scale factor: raw_reading / known_kPa.
// Procedure (see https://makersportal.com/blog/2020/6/4/mps20n0040d-pressure-sensor-calibration-with-arduino):
//   1. Set the CALIBRATION_FACTOR below to 1.0, upload, and tare with the
//      sensor open to free air (no pressure applied, tube disconnected or
//      open-ended).
//   2. Apply a known reference pressure with a water manometer (a column of
//      water h cm converts to Pa via P = rho * g * h -> kPa = h_cm * 0.09807)
//      and note the raw reading printed over Serial.
//   3. CALIBRATION_FACTOR = raw_reading / known_kPa
// get_units() then returns kPa directly once the correct factor is set.
const float CALIBRATION_FACTOR_1 = 1.0; // TODO: replace with measured value for sensor1
const float CALIBRATION_FACTOR_2 = 1.0; // TODO: replace with measured value for sensor2
const float CALIBRATION_FACTOR_3 = 1.0; // TODO: replace with measured value for sensor3

const unsigned long SEND_INTERVAL_MS = 1000;
unsigned long lastSendTime = 0;

// Waits for the sensor to report ready before taring, instead of tareing
// only if it happens to already be ready. HX710B often isn't ready
// immediately after begin(), so a one-shot is_ready() check can race and
// silently skip the tare, leaving OFFSET at 0 and raw ADC counts flowing
// straight through as the "calibrated" reading.
bool tareWithTimeout(HX711 &sensor, unsigned long timeoutMs = 1000) {
  unsigned long start = millis();
  while (!sensor.is_ready()) {
    if (millis() - start > timeoutMs) return false;
    delay(1);
  }
  sensor.tare();
  return true;
}

// --- Helper Function to Translate Numbers to Words ---
String getMoistureStatus(int analogValue) {
  if (analogValue >= DRY_THRESHOLD) {
    return "Dry";
  } else if (analogValue <= WET_THRESHOLD) {
    return "Wet";
  } else {
    return "Moist";
  }
}

void connectWiFi() {
  Serial.print("Connecting to WiFi: ");
  Serial.println(WIFI_SSID);

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.print("WiFi connected. IP address: ");
  Serial.println(WiFi.localIP());
}

void webSocketEvent(WStype_t type, uint8_t * payload, size_t length) {
  switch (type) {
    case WStype_DISCONNECTED:
      Serial.println("[WS] Disconnected");
      break;
    case WStype_CONNECTED:
      Serial.print("[WS] Connected to ");
      Serial.println((char *)payload);
      webSocket.sendTXT("{\"type\":\"hello\",\"device\":\"" + String(DEVICE_ID) + "\"}");
      break;
    case WStype_TEXT:
      Serial.print("[WS] Received: ");
      Serial.println((char *)payload);
      break;
    case WStype_ERROR:
      Serial.println("[WS] Error");
      break;
    default:
      break;
  }
}

void setup() {
  Serial.begin(115200);
  Serial.println("Starting Sensors...");

  // Setup moisture pins
  pinMode(moisturePin1, INPUT);
  pinMode(moisturePin2, INPUT);
  pinMode(moisturePin3, INPUT);

  // Initialize the pressure sensors with the new pin pairs
  sensor1.begin(PRESS_1_OUT, PRESS_1_SCK);
  sensor2.begin(PRESS_2_OUT, PRESS_2_SCK);
  sensor3.begin(PRESS_3_OUT, PRESS_3_SCK);

  // Apply calibration factors and zero each sensor with no pressure applied.
  // IMPORTANT: the pitot tube/hose should be open to free air (no pressure
  // differential) when the board boots.
  sensor1.set_scale(CALIBRATION_FACTOR_1);
  sensor2.set_scale(CALIBRATION_FACTOR_2);
  sensor3.set_scale(CALIBRATION_FACTOR_3);

  if (!tareWithTimeout(sensor1)) Serial.println("Sensor 1 tare timed out (not ready).");
  if (!tareWithTimeout(sensor2)) Serial.println("Sensor 2 tare timed out (not ready).");
  if (!tareWithTimeout(sensor3)) Serial.println("Sensor 3 tare timed out (not ready).");

  connectWiFi();

  webSocket.begin(WS_HOST, WS_PORT, WS_PATH);
  webSocket.onEvent(webSocketEvent);
  webSocket.setReconnectInterval(3000);
}

void loop() {
  webSocket.loop();

  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }

  unsigned long now = millis();
  if (now - lastSendTime < SEND_INTERVAL_MS) {
    return;
  }
  lastSendTime = now;

  // ==========================================
  // 1. Read Moisture Sensors
  // ==========================================
  int moist1 = analogRead(moisturePin1);
  int moist2 = analogRead(moisturePin2);
  int moist3 = analogRead(moisturePin3);

  String moistStatus1 = getMoistureStatus(moist1);
  String moistStatus2 = getMoistureStatus(moist2);
  String moistStatus3 = getMoistureStatus(moist3);

  Serial.println("--- Moisture Readings ---");
  Serial.print("Sensor 1 (D32): "); Serial.print(moist1); Serial.print(" -> "); Serial.println(moistStatus1);
  Serial.print("Sensor 2 (D35): "); Serial.print(moist2); Serial.print(" -> "); Serial.println(moistStatus2);
  Serial.print("Sensor 3 (D34): "); Serial.print(moist3); Serial.print(" -> "); Serial.println(moistStatus3);

  // ==========================================
  // 2. Read Pressure Sensors
  // ==========================================
  bool p1Ready = sensor1.is_ready();
  bool p2Ready = sensor2.is_ready();
  bool p3Ready = sensor3.is_ready();

  long press1Raw = p1Ready ? sensor1.read() : 0;
  long press2Raw = p2Ready ? sensor2.read() : 0;
  long press3Raw = p3Ready ? sensor3.read() : 0;

  // get_units() applies the tare offset and calibration factor set in
  // setup(), returning kPa once each sensor's factor has been measured.
  float press1Kpa = p1Ready ? sensor1.get_units() : 0.0;
  float press2Kpa = p2Ready ? sensor2.get_units() : 0.0;
  float press3Kpa = p3Ready ? sensor3.get_units() : 0.0;
  // "value" is kept as the field name (rather than e.g. "kpa") so the
  // existing server, DB schema, ML pipeline, and frontend — which all
  // already read pressure.value — keep working unchanged. It now just
  // carries a calibrated kPa reading instead of a raw ADC count.

  Serial.println("--- Pressure Readings ---");
  if (p1Ready) { Serial.print("Pressure 1 (OUT:21/SCK:5):  raw="); Serial.print(press1Raw); Serial.print(" kPa="); Serial.println(press1Kpa); }
  else { Serial.println("Pressure 1 not ready. (Check wiring on 21/5)"); }

  if (p2Ready) { Serial.print("Pressure 2 (OUT:19/SCK:4):  raw="); Serial.print(press2Raw); Serial.print(" kPa="); Serial.println(press2Kpa); }
  else { Serial.println("Pressure 2 not ready. (Check wiring on 19/4)"); }

  if (p3Ready) { Serial.print("Pressure 3 (OUT:22/SCK:18): raw="); Serial.print(press3Raw); Serial.print(" kPa="); Serial.println(press3Kpa); }
  else { Serial.println("Pressure 3 not ready. (Check wiring on 22/18)"); }

  Serial.println("=========================\n");

  // ==========================================
  // 3. Send data over WebSocket (live)
  // ==========================================
  if (webSocket.isConnected()) {
    String json = "{";
    json += "\"device\":\"" + String(DEVICE_ID) + "\",";
    json += "\"timestamp\":" + String(now) + ",";
    json += "\"moisture\":{";
    json += "\"s1\":{\"raw\":" + String(moist1) + ",\"status\":\"" + moistStatus1 + "\"},";
    json += "\"s2\":{\"raw\":" + String(moist2) + ",\"status\":\"" + moistStatus2 + "\"},";
    json += "\"s3\":{\"raw\":" + String(moist3) + ",\"status\":\"" + moistStatus3 + "\"}";
    json += "},";
    json += "\"pressure\":{";
    json += "\"s1\":{\"ready\":" + String(p1Ready ? "true" : "false") + ",\"raw\":" + String(press1Raw) + ",\"value\":" + String(press1Kpa, 4) + "},";
    json += "\"s2\":{\"ready\":" + String(p2Ready ? "true" : "false") + ",\"raw\":" + String(press2Raw) + ",\"value\":" + String(press2Kpa, 4) + "},";
    json += "\"s3\":{\"ready\":" + String(p3Ready ? "true" : "false") + ",\"raw\":" + String(press3Raw) + ",\"value\":" + String(press3Kpa, 4) + "}";
    json += "}";
    json += "}";

    webSocket.sendTXT(json);
  }
}
